# Copy this file to .env.local and fill in your own deployed Worker.
# The frontend builds every API base URL as `${NEXT_PUBLIC_WORKER_URL}/${NEXT_PUBLIC_AUTH_TOKEN}`,
# matching the path-token gate on the writer's-desk admin surface in examples/cloudflare/index.ts.
# 本地局域网调试示例：http://192.168.101.8:8799（见本地 .env.local）
NEXT_PUBLIC_WORKER_URL=https://your-worker.example.workers.dev
NEXT_PUBLIC_AUTH_TOKEN=replace-with-your-own-auth-token

# ── 安卓壳（task-33）生产打包 ──
# 1. 将此处两行改为线上 Worker 与线上 AUTH_TOKEN（与 wrangler secret 一致）
# 2. 然后：npm run build && npx cap sync android
# 3. 再：cd android && ./gradlew assembleRelease  # 产出 app-arm64-v8a-release.apk / app-armeabi-v7a-release.apk
#    或： ./gradlew bundleRelease  # 合一 AAB（含双 ABI，Google Play 按设备分发）
# Windows PowerShell 临时覆盖：$env:NEXT_PUBLIC_WORKER_URL="https://..."; $env:NEXT_PUBLIC_AUTH_TOKEN="..."
# 壳内已放行 https://localhost 与 capacitor://localhost（见 wrangler.toml ALLOWED_ORIGINS）
